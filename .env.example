# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

APP_URL=https://studio.youtube.automation.internal
DATABASE_URL=room://youtube_automation.db

VIDEO_PROVIDER=veo
VIDEO_API_KEY=UNCONFIGURED
VIDEO_MODEL=veo-3.1-fast-generate-preview
VIDEO_API_BASE_URL=https://generativelanguage.googleapis.com

TTS_PROVIDER=gemini
TTS_API_KEY=UNCONFIGURED
TTS_MODEL=gemini-2.5-flash-preview-tts

GOOGLE_CLIENT_ID=UNCONFIGURED
GOOGLE_CLIENT_SECRET=UNCONFIGURED
GOOGLE_REDIRECT_URI=https://studio.youtube.automation.internal/oauth/callback

STORAGE_ENDPOINT=UNCONFIGURED
STORAGE_BUCKET=UNCONFIGURED
STORAGE_ACCESS_KEY=UNCONFIGURED
STORAGE_SECRET_KEY=UNCONFIGURED

AUTOMATION_WEBHOOK_SECRET=UNCONFIGURED
ENCRYPTION_KEY=UNCONFIGURED
